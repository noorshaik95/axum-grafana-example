# node_modules in every app — rebuilt inside the container via npm ci
**/node_modules

# Next.js build output — rebuilt inside the container
**/.next
**/out

# Local env files — never bake credentials into images
**/.env
**/.env.local
**/.env.*.local

# TypeScript incremental build info
**/*.tsbuildinfo
**/next-env.d.ts

# Test artifacts
**/coverage
**/.nyc_output

# Misc
**/.DS_Store
**/*.log
**/*.pem
**/.vercel
**/.vscode
**/.idea
**/*.swp
**/*.swo
