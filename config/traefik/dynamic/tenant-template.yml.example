# Generated by tenant-service for tenant: {tenantId}
# This file is auto-created when a tenant is provisioned.
# Traefik watches this directory and hot-reloads on changes.
http:
  routers:
    tenant-{id}:
      rule: "Host(`{slug}.slate.local`)"
      entryPoints:
        - web
      service: api-gateway-svc
      middlewares:
        - inject-tenant-{id}

  middlewares:
    inject-tenant-{id}:
      headers:
        customRequestHeaders:
          X-Tenant-ID: "{id}"

  services:
    api-gateway-svc:
      loadBalancer:
        servers:
          - url: "http://api-gateway:8080"
