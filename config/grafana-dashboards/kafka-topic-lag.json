{
  "uid": "slate-kafka-topic-lag",
  "title": "Slate — Kafka Topic Lag (16 topics)",
  "description": "Consumer-group lag per topic across all 16 cross-cutting topics (docs/plan.md §Cross-cutting Concerns). One panel per topic.",
  "tags": ["slate", "kafka", "wave5"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "onboarding.approved",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group) (kafka_consumergroup_lag{topic=\"onboarding.approved\"})",
          "legendFormat": "{{group}}"
        }
      ]
    },
