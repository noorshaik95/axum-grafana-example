{
  "uid": "slate-business",
  "title": "Slate Business Metrics",
  "description": "Course activity, enrollments, content uploads, and user engagement",
  "tags": ["slate", "business"],
  "timezone": "browser",
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Courses Published (all time)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(courses_published_total)",
          "legendFormat": "Published",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Courses Unpublished (all time)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(courses_unpublished_total)",
          "legendFormat": "Unpublished",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Courses from Templates",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(courses_from_templates_total)",
          "legendFormat": "From Templates",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Templates Created",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(templates_created_total)",
          "legendFormat": "Templates",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Upload Sessions",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cms_active_upload_sessions",
          "legendFormat": "Active Uploads",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Transcoding Queue",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cms_transcoding_queue_size",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Course Activity Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(courses_published_total[1h])",
          "legendFormat": "Published",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(courses_unpublished_total[1h])",
          "legendFormat": "Unpublished",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(courses_from_templates_total[1h])",
          "legendFormat": "From Templates",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Content Upload & Transcoding",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cms_active_upload_sessions",
          "legendFormat": "Active Uploads",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "cms_transcoding_queue_size",
          "legendFormat": "Transcoding Queue",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "cms_video_completion_rate",
          "legendFormat": "Video Completion Rate",
          "refId": "C"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "User Login Activity",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(user_logins_total[5m])",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "CMS DB Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "cms_db_connections_active",
          "legendFormat": "CMS Active Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "logs",
      "title": "Course & Content Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{container=~\"slate-course-service-1|slate-content-management-service-1\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
