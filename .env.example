# ============================================================================
# Slate LMS — Local Development Environment Variables
# Copy this file to .env and adjust values as needed.
# ============================================================================

# ============================================================================
# PostgreSQL (User Auth)
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=userauth
# Host port: 5435

# ============================================================================
# PostgreSQL (Assignment Grading)
# ============================================================================
ASSIGNMENT_DB_USER=postgres
ASSIGNMENT_DB_PASSWORD=postgres
ASSIGNMENT_DB_NAME=assignment_grading
# Host port: 5433

# ============================================================================
# PostgreSQL (Content Management)
# ============================================================================
CMS_DB_USER=cms
CMS_DB_PASSWORD=cms_password
CMS_DB_NAME=cms
# Host port: 5434

# ============================================================================
# MongoDB (Course Service)
# ============================================================================
MONGO_INITDB_DATABASE=courses
# Host port: 27017

# ============================================================================
# Redis
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# MinIO (S3-compatible storage)
# ============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# API port: 9000, Console port: 9001

# ============================================================================
# Kafka
# ============================================================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
# Host port: 9097 (maps to internal 9092)

# ============================================================================
# User Auth Service (Go) — port 8081, gRPC 50051, metrics 9091
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=userauth
DB_SSLMODE=disable
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_DURATION=15
JWT_REFRESH_TOKEN_DURATION=168
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
AUTH_TYPE=normal
LOG_LEVEL=info
ENVIRONMENT=development

# ============================================================================
# Course Service (NestJS) — port 3001, gRPC 50052, metrics 9094
# ============================================================================
# NODE_ENV=production
# PORT=3001
# GRPC_PORT=50052
# MONGO_URI=mongodb://mongodb:27017/courses
# MONGO_DB_NAME=courses

# ============================================================================
# Content Management Service (Rust) — port 8082, gRPC 50054, metrics 9096
# ============================================================================
CMS_SERVER_HOST=0.0.0.0
CMS_SERVER_PORT=8082
CMS_GRPC_PORT=50054
CMS_METRICS_PORT=9092
CMS_DATABASE_URL=postgresql://cms:cms_password@localhost:5434/cms
CMS_DB_MAX_CONNECTIONS=20
CMS_DB_MIN_CONNECTIONS=5
CMS_S3_ENDPOINT=http://localhost:9000
CMS_S3_ACCESS_KEY=minioadmin
CMS_S3_SECRET_KEY=minioadmin
CMS_S3_BUCKET=content-storage
CMS_S3_REGION=us-east-1
CMS_ELASTICSEARCH_URL=http://localhost:9200
CMS_ELASTICSEARCH_INDEX=content
CMS_REDIS_URL=redis://localhost:6379
CMS_REDIS_QUEUE_NAME=transcoding_jobs

# ============================================================================
# Assignment Grading Service (Go) — port 8083, gRPC 50053, metrics 9093
# ============================================================================
# ASSIGNMENT_SERVER_HOST=0.0.0.0
# ASSIGNMENT_SERVER_PORT=8083
# ASSIGNMENT_GRPC_PORT=50053
# KAFKA_ENABLED=true
# KAFKA_BROKERS=kafka:9092
# KAFKA_TOPIC=assignment-events
# STORAGE_TYPE=local
# STORAGE_MAX_SIZE=26214400

# ============================================================================
# API Gateway (Rust/Axum) — port 8080
# ============================================================================
GATEWAY_SERVER_HOST=0.0.0.0
GATEWAY_SERVER_PORT=8080
GATEWAY_AUTH_SERVICE_ENDPOINT=http://localhost:50051
GATEWAY_OBSERVABILITY_TEMPO_ENDPOINT=http://localhost:4317
MAX_REQUEST_BODY_SIZE=1048576
MAX_UPLOAD_BODY_SIZE=26214400
UPLOAD_PATHS=/upload,/api/upload,/api/assignments/*/submissions

# ============================================================================
# Frontend Services
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
# Student: port 3000
# Provider: port 3002
# Admin: port 3003

# ============================================================================
# Observability
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
RUST_LOG=info
# Grafana: port 3500 (moved from 3000 to avoid conflict with student frontend)
# Prometheus: port 9090
# Tempo: port 3200
# Loki: port 3100
